# Backend defaults: local SQLite and explicit demo exchange rates.
FX_PROVIDER=demo
STORAGE_BACKEND=sqlite
CORS_ORIGINS=http://localhost:5173
# Optional live conversion (load into backend process environment):
# FX_PROVIDER=exchangerate
# EXCHANGE_RATE_API_KEY=configure-securely
# Optional API authentication; required by the AWS deployment template:
# APP_API_KEY=configure-securely
# DynamoDB mode (uses AWS SDK default credential chain):
# STORAGE_BACKEND=dynamodb
# TRANSACTIONS_TABLE=sentinel-transactions
# Frontend build-time configuration in frontend/.env.local:
# VITE_API_URL=https://your-api-domain
